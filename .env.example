# Aliyun Bailian (DashScope) OpenAI-compatible API configuration.
# Copy this file to .env and fill in your own values.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Connect timeout in seconds and response timeout in seconds.
LLM_CONNECT_TIMEOUT=10
LLM_TIMEOUT=120

# Retry transient API failures at most once.
LLM_MAX_RETRIES=1
